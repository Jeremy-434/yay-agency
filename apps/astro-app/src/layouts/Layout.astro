---
// https://docs.astro.build/en/guides/view-transitions/
import { ViewTransitions } from 'astro:transitions';
import '../styles/globals.css';
import CustomCursor from '../components/CustomCursor';
import SurveyPopup from '../components/SurveyPopup';
import ScrollIndicator from '../components/ScrollIndicator';

interface Props {
  title: string;
  showFooter?: boolean;
}

const { title, showFooter = true } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <link
      rel="icon"
      type="image/jpeg"
      href="/logo/Logo Avatar Dark 2.jpg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />

    <!-- Google fonts -->
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    />
    <link
      rel="preload"
      href="/CrimsonPro/CrimsonPro-VariableFont_wght.ttf"
      as="font"
      type="font/truetype"
      crossorigin
    />

    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="selection:bg-[var(--color-brand-accent)] selection:text-[var(--color-brand-primary)]">
    <CustomCursor client:load />
    <SurveyPopup client:load />
    <ScrollIndicator client:load />
    <div class="app-wrapper">
      <header class="header">
        <div class="header__container">
          <a
            class="header__title"
            href="/"
            style="font-family: var(--font-family-display); font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;"
            >Invenio</a
          >
          
          <button class="mobile-toggle" aria-label="Toggle Menu">
            <span></span>
            <span></span>
          </button>

          <nav class="header__nav">
            <a href="#servicios">Servicios</a>
            <a href="#proceso">Proceso</a>
            <a href="#contacto" class="nav-cta">Comenzar</a>
          </nav>
        </div>
      </header>

      <main>
        <slot />
      </main>

      {showFooter && (
        <footer class="footer">
          <div class="footer__content">
            <div class="footer__brand">
              <h2 class="footer__logo">Invenio Agency</h2>
              <p class="footer__tagline">Del descubrimiento al cierre, sin fricción.</p>
            </div>
            <div class="footer__grid">
              <div class="footer__col">
                <h4>Servicios</h4>
                <ul>
                  <li>Agentes de IA</li>
                  <li>Automatización CRM</li>
                  <li>Funnels de Venta</li>
                </ul>
              </div>
              <div class="footer__col">
                <h4>Compañía</h4>
                <ul>
                  <li>Sobre nosotros</li>
                  <li>Casos de éxito</li>
                  <li>Contacto</li>
                </ul>
              </div>
            </div>
          </div>
          <div class="footer__bottom">
            <p>&copy; 2026 Invenio Agency. Todos los derechos reservados.</p>
          </div>
        </footer>
      )}
    </div>

    <script>
      function setupInteractions() {
        const toggle = document.querySelector('.mobile-toggle');
        
        // Remove existing listeners to avoid duplicates during view transitions
        toggle?.replaceWith(toggle.cloneNode(true));
        const newToggle = document.querySelector('.mobile-toggle');
        const newNav = document.querySelector('.header__nav');

        newToggle?.addEventListener('click', () => {
          newToggle.classList.toggle('active');
          newNav?.classList.toggle('active');
          document.body.classList.toggle('overflow-hidden');
        });

        // Close menu on link click
        const navLinks = document.querySelectorAll('.header__nav a');
        navLinks.forEach(link => {
          link.addEventListener('click', () => {
            newToggle?.classList.remove('active');
            newNav?.classList.remove('active');
            document.body.classList.remove('overflow-hidden');
          });
        });

        // Global delegation for buttons and CTA links to handle dynamic content
        document.addEventListener('click', (e) => {
          const target = (e.target as HTMLElement).closest('button, .nav-cta, .cta-button');
          if (!target) return;
          
          // Skip internal components of the survey itself
          if (target.closest('.sv-card')) return;
          if (target.classList.contains('mobile-toggle')) return;
          
          // Skip internal navigation anchors that aren't marked as CTAs
          if (target.tagName === 'A' && !target.classList.contains('nav-cta') && !target.classList.contains('cta-button')) return;

          e.preventDefault();
          window.dispatchEvent(new CustomEvent('open-survey'));
        });
      }

      // Initial setup
      setupInteractions();

      // Setup on each page load (ViewTransitions support)
      document.addEventListener('astro:page-load', setupInteractions);
    </script>
  </body>
</html>

<style>
  .app-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  .header {
    background: var(--color-bg-glass);
    backdrop-filter: blur(var(--blur-md));
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-sticky);
    border-bottom: 1px solid rgba(174, 195, 176, 0.1);
  }

  .header__container {
    max-width: var(--container-xl);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-4) var(--spacing-6);
    @media (min-width: 768px) {
      padding: var(--spacing-4) var(--spacing-8);
    }
  }

  .header__title {
    font-size: var(--font-size-lg);
    text-decoration: none;
    color: var(--color-text-primary);
    z-index: 100;
  }

  .mobile-toggle {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    z-index: 100;
    @media (min-width: 768px) {
      display: none;
    }

    & span {
      display: block;
      width: 25px;
      height: 2px;
      background: var(--color-brand-sage);
      transition: all 0.3s ease;
    }

    &.active span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }
    &.active span:nth-child(2) {
      transform: rotate(-45deg);
    }
  }

  .header__nav {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-bg-dark);
    padding: 100px var(--spacing-8);
    gap: var(--spacing-8);
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    z-index: 90;

    &.active {
      transform: translateX(0);
    }

    @media (min-width: 768px) {
      position: static;
      flex-direction: row;
      background: none;
      padding: 0;
      gap: var(--spacing-6);
      transform: none;
      align-items: center;
    }

    & a {
      color: var(--color-text-primary);
      text-decoration: none;
      font-size: var(--font-size-xl);
      font-weight: 500;
      @media (min-width: 768px) {
        font-size: var(--font-size-sm);
        color: var(--color-text-secondary);
      }

      &:hover {
        color: var(--color-brand-accent);
      }
    }

    & .nav-cta {
      background: rgb(89, 131, 146);
      color: var(--color-brand-primary);
      padding: var(--spacing-4) var(--spacing-8);
      border-radius: var(--radius-full);
      font-weight: 700;
      text-align: center;
      transition: all 0.3s ease;
      @media (min-width: 768px) {
        padding: var(--spacing-2) var(--spacing-5);
        font-weight: 600;
      }

      &:hover {
        background: var(--color-brand-cream);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(89, 131, 146, 0.3);
      }
    }
  }

  .footer {
    background: var(--color-bg-darker);
    padding: var(--fluid-40-80) var(--spacing-6);
    border-top: 1px solid rgba(174, 195, 176, 0.05);

    & .footer__content {
      max-width: var(--container-xl);
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: var(--spacing-10);
      @media (min-width: 768px) {
        flex-direction: row;
        justify-content: space-between;
      }
    }

    & .footer__brand {
      max-width: 300px;
      & .footer__logo {
        font-family: var(--font-family-display);
        color: var(--color-brand-cream);
        margin-bottom: var(--spacing-4);
      }
      & .footer__tagline {
        color: var(--color-text-muted);
        font-style: italic;
      }
    }

    & .footer__grid {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-10);
      @media (min-width: 480px) {
        flex-direction: row;
        gap: var(--spacing-20);
      }
    }

    & .footer__col {
      & h4 {
        color: var(--color-brand-sage);
        font-size: var(--font-size-xs);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-wide);
        margin-bottom: var(--spacing-4);
      }
      & ul {
        list-style: none;
        & li {
          color: var(--color-text-secondary);
          margin-bottom: var(--spacing-2);
          font-size: var(--font-size-sm);
        }
      }
    }

    & .footer__bottom {
      max-width: var(--container-xl);
      margin: 0 auto;
      margin-top: var(--spacing-12);
      padding-top: var(--spacing-6);
      border-top: 1px solid rgba(174, 195, 176, 0.05);
      text-align: center;
      & p {
        font-size: var(--font-size-xs);
        color: var(--color-text-muted);
      }
    }
  }
</style>