---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import Portfolio from '../components/Portfolio';
import Services from '../components/Services';

import '../styles/globals.css';
---

<Layout title="Invenio Agency — Automatización Inteligente & Funnels de Venta">
  <!-- Hero Section -->
  <section id="hero" style="margin: 0; padding: 0;">
    <Hero 
      client:load 
      title1="Invenio Agency"
      title2="En Movimiento"
    />
  </section>

  <!-- Services Section -->
  <section id="servicios">
    <Services client:visible />
  </section>

  <!-- Process / Portfolio Section -->
  <section id="proceso" class="process-section">
    <div class="container-custom">
      <div class="process-header">
        <span class="process-num">03</span>
        <div class="process-title-block">
          <p class="process-eyebrow">Metodología</p>
          <h2 class="process-heading">El Sistema Invenio</h2>
        </div>
      </div>

      <div class="strata-grid">
        <div class="strata-item">
          <div class="strata-bar strata-1"></div>
          <div class="strata-content">
            <h3>Descubrimiento</h3>
            <p>Capturamos la atención del prospecto ideal a través de campañas de performance optimizadas.</p>
          </div>
        </div>
        <div class="strata-item">
          <div class="strata-bar strata-2"></div>
          <div class="strata-content">
            <h3>Cualificación</h3>
            <p>Nuestros agentes de IA filtran y preparan al lead, asegurando que solo los mejores lleguen a ti.</p>
          </div>
        </div>
        <div class="strata-item">
          <div class="strata-bar strata-3"></div>
          <div class="strata-content">
            <h3>Conversión</h3>
            <p>Sistemas automatizados de seguimiento que cierran la brecha entre el interés y la venta.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio -->
  <section id="casos">
    <Portfolio client:visible />
  </section>

  <!-- Contact / CTA -->
  <section id="contacto" class="cta-section section-padding">
    <div class="container-custom">
      <div class="cta-card">
        <h2 class="cta-title">¿Listo para escalar sin fricción?</h2>
        <p class="cta-text">Hablemos sobre cómo podemos automatizar tu proceso de ventas hoy mismo.</p>
        <button class="cta-button">Agendar Consultoría →</button>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    display: inline-block;
    line-height: 1;
    text-transform: none;
    letter-spacing: normal;
    word-wrap: normal;
    white-space: nowrap;
    direction: ltr;
  }
</style>

<style>
  /* Process Section */
  .process-section {
    background: var(--color-bg-darker);
    padding-block: var(--fluid-40-80);
    padding-inline: var(--spacing-6);
  }
  @media (min-width: 768px) {
    .process-section { padding-inline: var(--spacing-12); }
  }
  .process-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
    margin-bottom: var(--fluid-40-80);
  }
  .process-num {
    font-family: var(--font-family-display);
    font-size: var(--font-size-4xl);
    line-height: 1;
    color: rgba(174, 195, 176, 0.1);
  }
  .process-eyebrow {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-brand-accent);
    margin-bottom: var(--spacing-1);
  }
  .process-heading {
    font-family: var(--font-family-display);
    font-size: var(--font-size-2xl);
    color: var(--color-brand-cream);
  }

  /* Strata Grid */
  .strata-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-12);
  }
  @media (min-width: 768px) {
    .strata-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-8);
    }
  }
  .strata-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }
  .strata-bar {
    height: 8px;
    border-radius: var(--radius-full);
  }
  .strata-1 { background: var(--color-brand-secondary); width: 100%; }
  .strata-2 { background: var(--color-brand-accent); width: 80%; }
  .strata-3 { background: var(--color-brand-sage); width: 60%; }
  .strata-content h3 {
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-3);
    color: var(--color-brand-cream);
  }
  .strata-content p {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }

  /* CTA Section */
  .cta-section {
    background: var(--color-bg-darker);
  }
  .cta-card {
    background: var(--color-brand-secondary);
    padding: var(--fluid-40-80);
    border-radius: var(--radius-2xl);
    text-align: center;
    max-width: 1000px;
    margin: 0 auto;
  }
  .cta-title {
    font-family: var(--font-family-display);
    font-size: clamp(2rem, 1.5rem + 3vw, 4rem);
    color: var(--color-brand-cream);
    margin-bottom: var(--spacing-6);
  }
  .cta-text {
    font-size: var(--font-size-lg);
    color: var(--color-brand-sage);
    margin-bottom: var(--spacing-10);
    max-width: 600px;
    margin-inline: auto;
  }
  .cta-button {
    display: inline-block;
    background: var(--color-brand-accent);
    color: var(--color-brand-primary);
    padding: var(--spacing-5) var(--spacing-12);
    border-radius: var(--radius-full);
    font-size: var(--font-size-base);
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-family-main);
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .cta-button:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(89, 131, 146, 0.4);
    background: var(--color-brand-cream);
  }
</style>
