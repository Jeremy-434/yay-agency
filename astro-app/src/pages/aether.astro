---
import Layout from '../layouts/AetherLayout.astro';
import Navbar from '../components/Aether/Navbar';
import Hero from '../components/Aether/Hero';
import Portfolio from '../components/Aether/Portfolio';
import Services from '../components/Aether/Services';
import Footer from '../components/Aether/Footer';
import '../styles/globals.css';
---

<Layout title="AETHER MOTION - Creative Excellence">
  <main class="bg-[var(--color-aether-background)] text-[var(--color-aether-on-background)] min-h-screen font-sans selection:bg-[var(--color-aether-primary-container)] selection:text-[var(--color-aether-on-primary-container)]">
    <Navbar client:load />
    <Hero client:load />
    <Portfolio client:load />
    <Services client:load />
    <Footer client:load />
  </main>
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap');

  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    display: inline-block;
    line-height: 1;
    text-transform: none;
    letter-spacing: normal;
    word-wrap: normal;
    white-space: nowrap;
    direction: ltr;
  }
</style>
