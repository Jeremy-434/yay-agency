---
import Card from "../components/Card.astro";
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import { getPosts } from "../utils/sanity";
import Hero from "@features/hero/Hero.tsx";

const posts = await getPosts();
---

<Layout title="Antigravity - Elite Interactive Agency">
  <!-- Hero Section -->
  <Hero 
    client:load
    title="Antigravity"
    subtitle="Elite Interactive Agency"
    ctaText="Explore Our Work"
    ctaHref="#portfolio"
  />

  <!-- Portfolio/Posts Section -->
  <section id="portfolio" style="padding: 4rem 2rem; min-height: 50vh;">
    {posts.length ? posts.map((post) => <Card post={post} />) : <Welcome />}
  </section>
</Layout>
